---
// Logotipo ufficiale ITAKA (cartella Brand, "Itaka logo.svg"), colore ereditato dal testo.
import d from './logo-path.txt?raw';
interface Props { title?: string }
const { title = 'ItaKA' } = Astro.props;
---
<svg viewBox="0 0 660 155" role="img" aria-label={title} xmlns="http://www.w3.org/2000/svg"><path d={d.trim()} fill="currentColor" /></svg>
