---
// Icone a linea (Lucide, licenza ISC), colore ereditato dal testo.
import megaphone from 'lucide-static/icons/megaphone.svg?raw';
import heartHandshake from 'lucide-static/icons/heart-handshake.svg?raw';
import leaf from 'lucide-static/icons/leaf.svg?raw';
import lightbulb from 'lucide-static/icons/lightbulb.svg?raw';
import calendar from 'lucide-static/icons/calendar.svg?raw';
import mapPin from 'lucide-static/icons/map-pin.svg?raw';
import users from 'lucide-static/icons/users.svg?raw';
import handshake from 'lucide-static/icons/handshake.svg?raw';
import globe from 'lucide-static/icons/globe.svg?raw';
import building from 'lucide-static/icons/building-2.svg?raw';
import mail from 'lucide-static/icons/mail.svg?raw';
import atSign from 'lucide-static/icons/at-sign.svg?raw';
import phone from 'lucide-static/icons/phone.svg?raw';
import landmark from 'lucide-static/icons/landmark.svg?raw';
import heart from 'lucide-static/icons/heart.svg?raw';
import doorOpen from 'lucide-static/icons/door-open.svg?raw';
import searchCheck from 'lucide-static/icons/search-check.svg?raw';
import map from 'lucide-static/icons/map.svg?raw';
import shieldCheck from 'lucide-static/icons/shield-check.svg?raw';
import sparkles from 'lucide-static/icons/sparkles.svg?raw';
import wallet from 'lucide-static/icons/wallet.svg?raw';
import flag from 'lucide-static/icons/flag.svg?raw';
import plane from 'lucide-static/icons/plane.svg?raw';
import fileDown from 'lucide-static/icons/file-down.svg?raw';
import sun from 'lucide-static/icons/sun.svg?raw';
import moon from 'lucide-static/icons/moon.svg?raw';

const icons: Record<string, string> = {
  megaphone, 'heart-handshake': heartHandshake, leaf, lightbulb, calendar, 'map-pin': mapPin, users, handshake,
  globe, building, mail, 'at-sign': atSign, phone, landmark, heart, 'door-open': doorOpen, 'search-check': searchCheck,
  map, 'shield-check': shieldCheck, sparkles, wallet, flag, plane, 'file-down': fileDown, sun, moon,
};
interface Props { name: string; class?: string }
const { name, class: cls = 'icon' } = Astro.props;
const raw = (icons[name] ?? '').replace(/<!--.*?-->/s, '').replace('<svg', `<svg aria-hidden="true" focusable="false" class="${cls}"`).replace(/class="lucide[^"]*"/, '');
---
<Fragment set:html={raw} />
