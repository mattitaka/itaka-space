---
// Emblema "Cofinanziato dall'Unione europea" costruito secondo la geometria ufficiale della bandiera UE
// (12 stelle su un cerchio di raggio 1/3 dell'altezza; colori Reflex Blue e giallo).
// DA SOSTITUIRE con il file ufficiale scaricato dal portale UE, nella lingua scelta.
interface Props { label: string }
const { label } = Astro.props;
const h = 100, w = 150, cx = 75, cy = 50, R = h / 3, r = h / 18;
function star(x: number, y: number) {
  const pts: string[] = [];
  for (let i = 0; i < 10; i++) {
    const rad = i % 2 === 0 ? r : r * 0.382;
    const a = -Math.PI / 2 + (i * Math.PI) / 5;
    pts.push(`${(x + rad * Math.cos(a)).toFixed(2)},${(y + rad * Math.sin(a)).toFixed(2)}`);
  }
  return pts.join(' ');
}
const stars = Array.from({ length: 12 }, (_, i) => {
  const a = (i * Math.PI) / 6;
  return star(cx + R * Math.sin(a), cy - R * Math.cos(a));
});
// label: "riga 1|riga 2"
const [line1, line2 = ''] = label.split('|');
---
<svg viewBox="0 0 480 100" role="img" aria-label={label.replace("|", " ")} xmlns="http://www.w3.org/2000/svg">
  <rect x="0.5" y="0.5" width={w - 1} height={h - 1} fill="#003399" stroke="#ffffff" stroke-width="1" />
  {stars.map((p) => <polygon points={p} fill="#FFCC00" />)}
  <text x="168" y="44" fill="currentColor" font-family="Arial, Helvetica, sans-serif" font-size="25">{line1}</text>
  <text x="168" y="76" fill="currentColor" font-family="Arial, Helvetica, sans-serif" font-size="25">{line2}</text>
</svg>
