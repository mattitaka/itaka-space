---
import Base from '../layouts/Base.astro';
import EmblemaUE from '../components/EmblemaUE.astro';
import Icon from '../components/Icon.astro';
import { rich, routes, type Lang } from '../i18n/ui';
import { t } from '../data';
interface Props { lang: Lang; project: 'heart' | 'fot' | 'edit' }
const { lang, project } = Astro.props;
const c = t(lang).projects;
const p = c[project];
const other: Lang = lang === 'it' ? 'en' : 'it';
type DL = { title: string; lang: string; text: string; label: string; meta: string; href: string };
const dls: DL[] = 'downloads' in p ? ((p as any).downloads as DL[]) : [];
const fullTitle: string | undefined = (p as any).fullTitle;
const enOnly = lang === 'it' ? 'Solo in inglese' : 'English only';
---
<Base lang={lang} title={p.name} current={project} alternate={routes[other][project]} description={p.lead}>
  <header class="page-head">
    <p class="kicker">{p.kind}</p>
    <h1 class="title">{p.name}</h1>
    {fullTitle && <p class="kicker" lang="en">{fullTitle}</p>}
    <p class="lead">{p.lead}</p>
  </header>
  <section class="section">
    <div class="keyfacts">
      {p.facts.map((f) => (<div><Icon name={f.i} /><p class="k">{f.k}</p><p set:html={rich(f.v)} /></div>))}
    </div>
  </section>
  {dls.length > 0 && (
    <section class="section">
      <h2 class="heading">{lang === 'it' ? 'Materiali' : 'Materials'}</h2>
      <div class="blocks">
        {dls.map((d) => (
          <div class="block download-block" lang={d.lang}>
            <Icon name="file-down" />
            <h3>{d.title}{d.lang === 'en' && lang === 'it' && d.href.includes('toolkit') && <span class="badge" lang="it">{enOnly}</span>}{d.lang === 'en' && lang === 'en' && d.href.includes('toolkit') && <span class="badge">{enOnly}</span>}</h3>
            <div class="dl-body">
              <p set:html={rich(d.text)} />
              <p class="actions"><a class="btn" href={d.href} download>{d.label}</a><span class="muted small">{d.meta}</span></p>
            </div>
          </div>
        ))}
      </div>
    </section>
  )}
  <section class="section">
    <div class="eu">
      <EmblemaUE label={c.eu.emblem} />
      <div class="small">
        <p class="muted">{p.code}</p>
        <p style="margin-top:0.5rem">{c.eu.disclaimer.replace('{ente}', (p as any).ente ?? '')}</p>
      </div>
    </div>
    <p><a class="textlink" href={routes[lang].projects}>{c.back}</a></p>
  </section>
</Base>
