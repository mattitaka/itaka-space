---
import Base from '../layouts/Base.astro';
import { rich, routes, type Lang } from '../i18n/ui';
import { t } from '../data';
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = t(lang).partners;
const other: Lang = lang === 'it' ? 'en' : 'it';
---
<Base lang={lang} title={t(lang).projectsIndex && (lang === 'it' ? 'Partner' : 'Partners')} current="partners" alternate={routes[other].partners}>
  <header class="page-head">
    <h1 class="title">{c.title}</h1>
    <p class="lead">{c.text}</p>
  </header>
  <section class="section">
    <ul class="partners">
      {c.rows.map((r) => (
        <li>
          <span class="logo-tile">{r[3] ? <img src={r[3]} alt={`Logo ${r[0]}`} loading="lazy" decoding="async" /> : <span class="logo-name" aria-hidden="true">{r[0]}</span>}</span>
          <p class="name">{r[0]}</p>
          <p class="muted small">{r[1]}</p>
          <p class="small">{r[2]}</p>
        </li>
      ))}
    </ul>
  </section>
  <section class="section">
    <p class="closing" style="grid-column: 1 / -1">{c.closing} <a href="mailto:ciao@itaka.space">ciao@itaka.space</a></p>
  </section>
</Base>
